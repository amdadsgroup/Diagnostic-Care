# ==============================================================================
# Diagnostic Care — Environment Configuration Template
# ==============================================================================

# Supabase Public Keys (Safe for Client-Side Use)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key-here

# Supabase Server-Only Secret (NEVER expose to client code or bundle)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_HELPLINE=01886748564

# Payment Gateway Public & Secret Credentials (Server-Side)
BKASH_APP_KEY=your-bkash-app-key
BKASH_APP_SECRET=your-bkash-app-secret
BKASH_USERNAME=your-bkash-username
BKASH_PASSWORD=your-bkash-password
NAGAD_MERCHANT_ID=your-nagad-merchant-id
