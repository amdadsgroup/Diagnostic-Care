# ==============================================================================
# Diagnostic Care — Environment Configuration Template (.env.example)
# Platform: Diagnostic Care | Your Healthcare Marketplace (Bangladesh)
# Customer Care Helpline: 01886748564 | Email: support@diagnosticcare.com
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Cloud Configuration (Client & Server)
# ------------------------------------------------------------------------------
# Supabase Project URL (Client & Server safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Public Anonymous Key (Client safe)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase Modern Publishable Key (Client safe)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Supabase Server-Only Secret (Privileged Service Role - NEVER expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Supabase Management Token & Project Reference (CI/CD and Database Automation)
SUPABASE_ACCESS_TOKEN=your-supabase-access-token
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_DB_HOST=db.your-project-id.supabase.co

# ------------------------------------------------------------------------------
# 2. Application Core Settings
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_HELPLINE=01886748564
NEXT_PUBLIC_BRAND_NAME="Diagnostic Care"
NEXT_PUBLIC_TAGLINE="Your Healthcare Marketplace"
NEXT_PUBLIC_CUSTOMER_CARE_PHONE="01886748564"

# ------------------------------------------------------------------------------
# 3. Security & Cryptographic Secrets (Server-Side Only)
# ------------------------------------------------------------------------------
REPORT_SIGNING_SECRET=your-report-signing-hmac-secret-key-32-chars
JWT_SECRET=your-jwt-auth-secret-key-32-chars-min

# ------------------------------------------------------------------------------
# 4. SMS Gateway (Greenweb Bangladesh / SSL Wireless)
# ------------------------------------------------------------------------------
GREENWEB_SMS_TOKEN=your-greenweb-sms-token
SMS_API_KEY=your-sms-api-key
SMS_SENDER_ID=DiagnosticCare

# ------------------------------------------------------------------------------
# 5. Email Gateway (SendGrid / SMTP)
# ------------------------------------------------------------------------------
SENDGRID_API_KEY=your-sendgrid-api-key
EMAIL_FROM=support@diagnosticcare.com

# ------------------------------------------------------------------------------
# 6. Bangladesh Payment Gateways (bKash, Nagad, SSLCommerz)
# ------------------------------------------------------------------------------
# bKash Direct Merchant
BKASH_APP_KEY=your-bkash-app-key
BKASH_APP_SECRET=your-bkash-app-secret
BKASH_USERNAME=your-bkash-username
BKASH_PASSWORD=your-bkash-password

# Nagad Online Gateway
NAGAD_MERCHANT_ID=your-nagad-merchant-id
NAGAD_PUBLIC_KEY=your-nagad-public-key
NAGAD_PRIVATE_KEY=your-nagad-private-key

# SSLCommerz Aggregator
SSLCOMMERZ_STORE_ID=your-sslcommerz-store-id
SSLCOMMERZ_STORE_PASSWORD=your-sslcommerz-store-password
